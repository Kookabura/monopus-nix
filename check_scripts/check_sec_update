#!/bin/bash
#
# Check for pending security package updates.
#
# Usage: check_sec_update [-w warning] [-c critical] [-H]
#   -w --warning    warning threshold (default: 1)
#   -c --critical   critical threshold (default: 5)
#   -H --help       output this help
#

warn=1
crit=5
os="unknown"
family=""

log() {
  printf 'check_sec_update: %s\n' "$*" >&2
}

print_help() {
  sed -n '2,9p' "$0" | sed 's/^# *//'
}

emit_result() {
  local key=$1
  local state=$2
  local count=$3
  local packages=$4

  log "result: state=$state, security updates=$count"

  if [ -n "$packages" ]; then
    printf 'check_sec_update.%s::sys==%s__sec==%s__packages==%s | sec_update=%s;;;;\n' \
      "$key" "$os" "$count" "$packages" "$count"
  else
    printf 'check_sec_update.%s::sys==%s__sec==%s | sec_update=%s;;;;\n' \
      "$key" "$os" "$count" "$count"
  fi
  exit "$state"
}

unknown() {
  [ -n "${1:-}" ] && log "$1"
  emit_result "unk" 3 0 ""
}

package_manager_error() {
  if [ -n "${command_output:-}" ]; then
    error_line=${command_output%%$'\n'*}
    log "package manager error: $error_line"
  else
    log "package manager returned no usable data"
  fi

  case "$family" in
    rpm) emit_result "error-centos" 2 0 "" ;;
    apt) emit_result "error-debubuntu" 2 0 "" ;;
    *)   unknown "package manager family is unknown" ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    --warning|-w)
      [ $# -ge 2 ] || unknown "warning threshold is missing"
      warn=$2
      shift 2
      ;;
    --critical|-c)
      [ $# -ge 2 ] || unknown "critical threshold is missing"
      crit=$2
      shift 2
      ;;
    --help|-H)
      print_help
      exit 3
      ;;
    *)
      unknown "unknown argument: $1"
      ;;
  esac
done

if ! [[ "$warn" =~ ^[0-9]+$ && "$crit" =~ ^[0-9]+$ ]] || [ "$warn" -gt "$crit" ]; then
  unknown "invalid thresholds: warning=$warn, critical=$crit"
fi

os_release_file=${OS_RELEASE_FILE:-/etc/os-release}

if [ ! -r "$os_release_file" ]; then
  unknown "cannot read $os_release_file"
fi

# shellcheck disable=SC1091
. "$os_release_file"

case "${ID,,}" in
  ubuntu)
    family="apt"
    os="Ubuntu"
    ;;
  debian)
    family="apt"
    os="Debian"
    ;;
  centos)
    family="rpm"
    os="Centos"
    ;;
  rhel)
    family="rpm"
    os="RHEL"
    ;;
  rocky)
    family="rpm"
    os="Rocky"
    ;;
  almalinux)
    family="rpm"
    os="AlmaLinux"
    ;;
  ol)
    family="rpm"
    os="OracleLinux"
    ;;
  fedora)
    family="rpm"
    os="Fedora"
    ;;
  *)
    os=${ID:-unknown}
    for os_like in ${ID_LIKE:-}; do
      case "${os_like,,}" in
        debian|ubuntu)
          family="apt"
          break
          ;;
        rhel|centos|fedora)
          family="rpm"
          break
          ;;
      esac
    done
    ;;
esac

[ -n "$family" ] || unknown "unsupported operating system: $os"

for required_command in awk sort paste; do
  command -v "$required_command" >/dev/null 2>&1 || unknown "required command is missing: $required_command"
done

packages=""

if [ "$family" = "rpm" ]; then
  if command -v dnf >/dev/null 2>&1; then
    package_manager="dnf"
  elif command -v yum >/dev/null 2>&1; then
    package_manager="yum"
  else
    unknown "neither dnf nor yum is installed"
  fi

  command_started=$SECONDS
  log "checking security updates with $package_manager"
  command_output=$(LC_ALL=C "$package_manager" -q --security check-update 2>&1)
  command_status=$?
  log "$package_manager finished in $((SECONDS - command_started)) seconds with exit code $command_status"

  # Both yum and dnf return 100 when updates are available.
  case "$command_status" in
    0)
      packages=""
      ;;
    100)
      packages=$(printf '%s\n' "$command_output" |
        awk '$0 ~ /^[[:alnum:]_+.-]+\.[[:alnum:]_]+[[:space:]]/ && NF >= 3 {print $1}' |
        sort -u)
      [ -n "$packages" ] || package_manager_error
      ;;
    *)
      package_manager_error
      ;;
  esac
else
  command -v apt >/dev/null 2>&1 || unknown "apt is not installed"

  command_started=$SECONDS
  log "checking security updates with apt"
  command_output=$(LC_ALL=C apt list --upgradable 2>&1)
  command_status=$?
  log "apt finished in $((SECONDS - command_started)) seconds with exit code $command_status"
  [ "$command_status" -eq 0 ] || package_manager_error

  packages=$(printf '%s\n' "$command_output" |
    awk '$1 ~ /^[^/]+\/[^[:space:]]*security/ {split($1, package, "/"); print package[1]}' |
    sort -u)
fi

if [ -n "$packages" ]; then
  count=$(printf '%s\n' "$packages" | awk 'NF {count++} END {print count+0}')
  package_list=$(printf '%s\n' "$packages" | paste -sd, -)
else
  count=0
  package_list=""
fi

if [ "$count" -ge "$crit" ]; then
  emit_result "cri" 2 "$count" "$package_list"
elif [ "$count" -ge "$warn" ]; then
  emit_result "war" 1 "$count" "$package_list"
else
  emit_result "ok" 0 "$count" "$package_list"
fi
